{
  "redirects": [
    {
      "source": "/new-developments",
      "destination": "/properties",
      "permanent": true
    },
    {
      "source": "/developments",
      "destination": "/properties",
      "permanent": true
    },
    {
      "source": "/offices",
      "destination": "/offices/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/api/bazaraki.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/offices/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/offices/options.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/offices/(.*)\\.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        }
      ]
    },
    {
      "source": "/offices/(.*)\\.svg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/svg+xml"
        }
      ]
    },
    {
      "source": "/offices/(.*)\\.jpg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/bazaraki.xml",
      "destination": "/api/bazaraki-xml"
    },
    {
      "source": "/((?!api|offices).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/bazaraki-xml.js": {
      "maxDuration": 30
    },
    "api/image.js": {
      "maxDuration": 30
    }
  }
}
