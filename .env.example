VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Supabase (public / anon only — never put the service role key in VITE_*)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key
# Optional server-side aliases for /api/bazaraki.xml (same values as above)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=your_anon_public_key
# Optional: newer publishable key (not required by @supabase/supabase-js)
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…

# After running supabase/migrations/20260826_001_cms_schema.sql, create an Auth user
# and activate: update public.profiles set active=true, role='super_admin' where email='…';
# Then open /admin/login

# Optional: WhatsApp / Telegram chat links (navbar + footer). Defaults in src/config/externalLinks.js.
# VITE_WHATSAPP_URL=https://wa.me/35700000000
# VITE_TELEGRAM_URL=https://t.me/yourhandle

# Optional: tel: link for phone icon in quick-contact FAB (defaults in src/config/externalLinks.js).
# VITE_CONTACT_PHONE_TEL=tel:+35725123456

# Optional: primary contact email (inquiry form mailto fallback + footer).
# VITE_CONTACT_EMAIL=info@unitedproperties.eu
